import numpy as np
import networkx as nx
import csv
from collections import defaultdict

# ---------- helpers ----------
def cos_sim(a, b, eps=1e-12):
    a = np.asarray(a); b = np.asarray(b)
    na = np.linalg.norm(a); nb = np.linalg.norm(b)
    if na < eps or nb < eps: return 0.0
    return float(np.dot(a, b) / (na * nb))

def cos_dist(a, b):
    return 1.0 - cos_sim(a, b)

def safe_add_edge(G, u, v, weight, etype, evidence=None):
    if u == v: return
    if G.has_edge(u, v):
        # keep the smallest distance; merge evidence types
        if weight < G[u][v]['weight']:
            G[u][v]['weight'] = weight
        G[u][v]['etype'].add(etype)
        if evidence: G[u][v]['evidence'].update(evidence)
    else:
        G.add_edge(u, v, weight=weight, etype={etype}, evidence=evidence or {})

# ---------- build graph ----------
G = nx.Graph()

# nodes from exact_index
for h, lst in exact_index.items():
    for gid, src, creator, vec in lst:
