# also add cross-bucket similarity (optional but useful)
# flatten all nodes with vectors
nodes_with_vec = [n for n, d in G.nodes(data=True) if d.get('vec') is not None]
for i in range(len(nodes_with_vec)):
    gi = nodes_with_vec[i]; vi = G.nodes[gi]['vec']
