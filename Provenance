# similarity edges within each hash bucket (exact family)
SIM_THRESH = 0.30  # max cosine distance to connect
for h, lst in exact_index.items():
    # fully connect near-duplicates
    for i in range(len(lst)):
        gid_i, src_i, c_i, v_i = lst[i]
        for j in range(i+1, len(lst)):
            gid_j, src_j, c_j, v_j = lst[j]
            d = cos_dist(v_i, v_j)
            if d <= SIM_THRESH:
                safe_add_edge(G, gid_i, gid_j, weight=d, etype='similarity')

# watermark pools
for sig, entries in sig_buckets.items():
