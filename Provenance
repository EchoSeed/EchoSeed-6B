# ---------- provenance scoring ----------
known = [n for n, d in G.nodes(data=True) if d.get('creator') not in (None, 'unknown')]
if not known:
    raise ValueError("No known-creator nodes to anchor provenance.")

# multi-source Dijkstra distances and predecessors
dist, pred = nx.multi_source_dijkstra(G, sources=known, weight='weight')

# component sizes for context
comp_size = {}
for comp in nx.connected_components(G):
    s = len(comp)
    for n in comp:
        comp_size[n] = s

def provenance_score(node):
    """Combine nearest-path distance, watermark agreement, and local density."""
    dnode = G.nodes[node]
    # nearest known
    if node not in dist:
        return 0.0, None, np.inf, 0, False  # unreachable
    # reconstruct path to nearest known source
    path = [node]
    while path[-1] not in known:
        path.append(pred[path[-1]])
    path_len = len(path) - 1
    nearest = path[-1]
    min_dist = dist[node]

    # normalize distance to [0,1] where 1 is best
    # clamp with a scale; beyond 1.0 is bad
    SCALE = 1.0
    d_score = max(0.0, 1.0 - min_dist / SCALE)

    # watermark agreement bonus
    wm_agree = False
    if G.nodes[node].get('wm') and G.nodes[nearest].get('wm'):
        wm_agree = (G.nodes[node]['wm'] == G.nodes[nearest]['wm'])
    wm_score = 0.15 if wm_agree else 0.0

    # local density via inverse average edge weight to neighbors
    nbrs = list(G.neighbors(node))
    if nbrs:
        avg_w = sum(G[node][v]['weight'] for v in nbrs) / len(nbrs)
        dens = max(0.0, 1.0 - avg_w / SCALE)  # lower avg_w = denser = better
    else:
        dens = 0.0
    dens_score = 0.20 * dens

    # component size prior
    c_score = min(0.15, 0.15 * (comp_size[node] / 50.0))  # cap at 0.15, scales up to size 50+

    # final score
    score = max(0.0, min(1.0, d_score + wm_score + dens_score + c_score))
    return score, nearest, min_dist, path_len, wm_agree

# ---------- export ----------
with open("provenance.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["gid","nearest_creator","score","min_dist","path_len","watermark_agree","component_size","file"])
    for gid, data in G.nodes(data=True):
        if data.get('creator') in (None, 'unknown'):
            score, nearest, md, pl, wma = provenance_score(gid)
            nc = G.nodes[nearest]['creator'] if nearest is not None else ""
            w.writerow([gid, nc, f"{score:.3f}", f"{md:.4f}", pl, int(wma), comp_size.get(gid, 1), data.get('file',"")])
